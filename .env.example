# ---------------------------------------------------------------------------
# CART Paper — environment
# Copy to .env (npm run setup does this for you) and adjust as needed.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=cart
POSTGRES_PASSWORD=cart
POSTGRES_DB=cartpaper
POSTGRES_PORT=5432

# API
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://cart:cart@db:5432/cartpaper
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=/data/uploads
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Social sign-in — empty means "not configured": the buttons render disabled
# and the endpoints answer 501. See docs/ARCHITECTURE.md to activate one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Web
WEB_PORT=5173
VITE_API_URL=http://localhost:8000
